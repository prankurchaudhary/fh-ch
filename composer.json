{
  "name": "pimcore/skeleton",
  "type": "project",
  "license": "proprietary",
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true,
    "process-timeout": 0,
    "allow-plugins": {
      "php-http/discovery": true,
      "symfony/runtime": true
    }
  },
  "prefer-stable": true,
  "minimum-stability": "dev",
  "require": {
    "php": "~8.3.0 || ~8.4.0",
    "cocur/slugify": "^4.7",
    "gesdinet/jwt-refresh-token-bundle": "^2.2",
    "knplabs/knp-paginator-bundle": "^6.10",
    "lexik/jwt-authentication-bundle": "^3.2",
    "nelmio/api-doc-bundle": "^5.10",
    "pimcore/admin-ui-classic-bundle": "^1.7",
    "pimcore/data-hub": "^1.9",
    "pimcore/data-importer": "^1.10",
    "pimcore/pimcore": "^11.5",
    "pimcore/platform-version": "^2024.4",
    "symfony/cache": "^6.4",
    "symfony/dotenv": "^6.2 || ^7.2",
    "symfony/form": "^7.2",
    "symfony/intl": "^7.0",
    "symfony/redis-messenger": "^7.2",
    "symfony/runtime": "^6.2 || ^7.3",
    "symfony/validator": "^6.4"
  },
  "require-dev": {
    "codeception/codeception": "^5.0.3",
    "codeception/module-symfony": "^3.1.0"
  },
  "suggest": {
    "pimcore/data-hub": "Universal data interface for GraphQL, CSV and other formats"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/",
      "Pimcore\\Model\\DataObject\\": "var/classes/DataObject",
      "App\\Migrations\\": "migrations/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "App\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "post-create-project-cmd": "Pimcore\\Composer::postCreateProject",
    "post-install-cmd": [
      "Pimcore\\Composer::postInstall",
      "@pimcore-scripts"
    ],
    "post-update-cmd": [
      "Pimcore\\Composer::postUpdate",
      "@pimcore-scripts"
    ],
    "pimcore-scripts": [
      "Pimcore\\Composer::clearCache",
      "Pimcore\\Composer::installAssets"
    ]
  }
}
