{% extends "frontend/base.html.twig" %}
{% block title %}User account | Xtreme Foodies - The world's Essential Eats curated by local food experts{% endblock %}
{% block cssblock %}


{% endblock %}
{% block body %}


<div class="container mt-5 mb-5 regform" style="max-width: 500px;">
 <h2 class="mb-4">Reset your Password</h2>
  {% for message in app.flashes('success') %}
        <div class="alert alert-success">{{ message }}</div>
    {% endfor %}

    {% for message in app.flashes('error') %}
        <div class="alert alert-danger">{{ message }}</div>
    {% endfor %}

    
     <form method="POST">
     <div class="mb-3">
            <label>New Password</label>
            <input type="password" name="password" class="form-control" required>           
        </div>
        
        <button type="submit" class="btn btn-primary w-100 form-submit">Reset Password</button>
    </form>
</div>

{% endblock %}
